#!/usr/bin/env bash
# pre-commit：提交前跑两道体检
#   1. Liquid 冲突符号（tools/check_liquid.py）—— 有命中就一定阻断
#   2. 首页知识图谱（tools/graph_sync.py + tools/kg_layout_check.mjs）
#
# 行为：
#   - 第 1 道对所有 md/html 生效：正文里任何裸 `{{` / `{%` 都会让 GitHub Pages
#     构建直接失败（Liquid syntax error），本地肉眼完全看不出来，所以必须拦住
#   - 第 2 道只在 _posts/*.md、_data/knowledge_graph.yml、assets/js/kg-layout.js
#     进入暂存区时才跑，其他提交零开销
#   - 第 2 道默认只提示、不阻断提交（写得再烂也能提交，WIP 不受影响）
#   - GRAPH_SYNC_STRICT=1 时切换为严格模式：有必须处理项就阻断
#   - 配置文件本身坏了（yml 解析失败 / 边指向不存在的系列）一定阻断
#   - 布局体检（tools/kg_layout_check.mjs）发现节点重叠时也一定阻断——那是肉眼可见的坏
#   - 临时跳过：git commit --no-verify
#
# 安装：bash tools/install_hooks.sh
set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

# ---------- 第 1 道：Liquid 冲突符号 ----------
# 找一个可用的 python3（脚本只用标准库）
PY_BASE="${CHECK_PYTHON:-}"
if [ -z "$PY_BASE" ]; then
  for cand in "$HOME/Software/miniconda3/bin/python3" "$(command -v python3 || true)" "$(command -v python || true)"; do
    if [ -n "$cand" ] && [ -x "$cand" ]; then
      PY_BASE="$cand"
      break
    fi
  done
fi

if [ -n "$PY_BASE" ]; then
  if ! "$PY_BASE" tools/check_liquid.py --staged; then
    echo ""
    echo "  以上写法会让 GitHub Pages 构建失败（Liquid 把 {{ 当标记开头）。"
    echo "  数学：{ \\rm data } 改成 \\mathrm{data}；代码块：包一层 {% raw %}...{% endraw %}。"
    echo "  确认无害就用 git commit --no-verify 跳过。"
    exit 1
  fi
else
  echo "check_liquid: 未找到 python3，跳过 Liquid 体检"
fi

changed="$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^(_posts/[^/]+\.md|_data/knowledge_graph\.yml|assets/js/kg-layout\.js)$' || true)"
if [ -z "$changed" ]; then
  exit 0
fi

# 找一个带 PyYAML 的 python（系统 python3 通常没装 yaml）
PY="${GRAPH_SYNC_PYTHON:-}"
if [ -z "$PY" ]; then
  for cand in "$HOME/Software/miniconda3/bin/python3" "$(command -v python3 || true)" "$(command -v python || true)"; do
    if [ -n "$cand" ] && [ -x "$cand" ] && "$cand" -c "import yaml" >/dev/null 2>&1; then
      PY="$cand"
      break
    fi
  done
fi
if [ -z "$PY" ]; then
  echo "knowledge-graph: 未找到带 PyYAML 的 python3，跳过体检（可用 GRAPH_SYNC_PYTHON=/path/to/python 指定）"
  exit 0
fi

echo "knowledge-graph: 检测到 $(printf '%s\n' "$changed" | wc -l | tr -d ' ') 个文章/配置变更，开始体检…"
"$PY" tools/graph_sync.py --quiet
status=$?

if [ "$status" -eq 2 ]; then
  echo ""
  echo "knowledge-graph: 配置文件有问题，已阻断提交。"
  echo "                 修好 _data/knowledge_graph.yml 再提交，或用 git commit --no-verify 临时跳过。"
  exit 1
fi

if [ "$status" -eq 1 ]; then
  echo ""
  echo "knowledge-graph: 严格模式（GRAPH_SYNC_STRICT=1）下存在必须处理项，已阻断提交。"
  echo "                 处理完再提交，或用 git commit --no-verify 临时跳过。"
  exit 1
fi

# ---------- 布局体检：节点有没有叠在一起 ----------
# 布局是纯函数（assets/js/kg-layout.js），直接跑断言即可，不需要浏览器。
if command -v node >/dev/null 2>&1; then
  if ! node tools/kg_layout_check.mjs --quiet; then
    echo ""
    echo "knowledge-graph: 布局体检未通过（节点重叠 / 越界），已阻断提交。"
    echo "                 布局参数在 assets/js/kg-layout.js 的 DEFAULTS，"
    echo "                 改完用 node tools/kg_layout_check.mjs 复查。"
    exit 1
  fi
else
  echo "knowledge-graph: 未找到 node，跳过布局体检"
fi

exit 0
