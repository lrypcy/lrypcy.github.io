# Jekyll 构建产物
_site/
.jekyll-cache/

# 本地工具与编辑器配置
.obsidian/
.omo/
.workbuddy/
.codegraph
Clippings/

# macOS 与其他无关文件
.DS_Store
*.base

# 访问统计本地预览数据库（tools/analytics/dev-server.mjs --db=...）
*.sqlite
*.sqlite-journal

# 访问统计部署时生成的口令备忘与凭据（tools/analytics/deploy.sh）
tools/analytics/.secrets.local
tools/analytics/.env.local

# wrangler 本地缓存
tools/analytics/.wrangler/
tools/analytics/**/.wrangler/

# 访问地图设计预览产物（tools/analytics/make-map-preview.mjs 生成，占位符由运行时替换）
tools/analytics/map-preview.html
# Python 字节码缓存
__pycache__/
*.pyc

# 每日资讯流水线的抓取产物（含正文全文，每天累积，不入库）
tools/daily/out/
