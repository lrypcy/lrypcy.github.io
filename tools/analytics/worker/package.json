{
  "name": "pcy-analytics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "lrypcy.github.io 的访问统计后端（Cloudflare Worker + D1）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute pcy-analytics --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute pcy-analytics --local --file=./schema.sql",
    "db:shell": "wrangler d1 execute pcy-analytics --remote --command",
    "test": "node --test ../test/*.test.mjs"
  }
}
